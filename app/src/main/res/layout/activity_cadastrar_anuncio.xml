<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloTela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Novo Anúncio"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Campo Título -->
        <EditText
            android:id="@+id/etTituloAnuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Título do produto"
            android:inputType="textCapSentences"
            android:minHeight="48dp" />

        <!-- Campo Preço -->
        <EditText
            android:id="@+id/etPrecoAnuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Preço (ex: 99.90)"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <!-- Campo Descrição -->
        <EditText
            android:id="@+id/etDescricaoAnuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="top"
            android:hint="Descrição detalhada do produto"
            android:inputType="textMultiLine"
            android:lines="3"
            android:minHeight="48dp" />

        <!-- Campo URL da Foto -->
        <EditText
            android:id="@+id/etFotoUrlAnuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="URL da Imagem (https://...)"
            android:inputType="textUri"
            android:minHeight="48dp" />

        <!-- Prévia da Imagem -->
        <ImageView
            android:id="@+id/imgPreviaAnuncio"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="24dp"
            android:background="#E0E0E0"
            android:contentDescription="Prévia da imagem do anúncio"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <!-- Botão Salvar Anúncio -->
        <Button
            android:id="@+id/btnCadastrarAnuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="12dp"
            android:text="Cadastrar Anúncio" />

        <!-- Botão Cancelar -->
        <Button
            android:id="@+id/btnCancelarAnuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#757575"
            android:padding="12dp"
            android:text="Cancelar" />

    </LinearLayout>
</ScrollView>