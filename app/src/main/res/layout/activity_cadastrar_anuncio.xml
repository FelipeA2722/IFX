<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FF"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloTela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Novo Anúncio"
            android:textColor="#1F2A44"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTituloAnuncio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:hint="Título do produto"
            android:inputType="textCapSentences"
            android:paddingHorizontal="16dp" />

        <EditText
            android:id="@+id/etPrecoAnuncio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:hint="Preço (ex: 99.90)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp" />

        <EditText
            android:id="@+id/etDescricaoAnuncio"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="Descrição detalhada do produto"
            android:inputType="textMultiLine"
            android:padding="16dp" />

        <EditText
            android:id="@+id/etFotoUrlAnuncio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:hint="URL da Imagem (https://...)"
            android:inputType="textUri"
            android:paddingHorizontal="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Categoria:"
            android:textColor="#1F2A44"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input" />

        <ImageView
            android:id="@+id/imgPreviaAnuncio"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="24dp"
            android:background="#E0E0E0"
            android:contentDescription="Prévia da imagem do anúncio"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <Button
            android:id="@+id/btnCadastrarAnuncio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_primary"
            android:padding="12dp"
            android:text="Cadastrar Anúncio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelarAnuncio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_secondary"
            android:padding="12dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>